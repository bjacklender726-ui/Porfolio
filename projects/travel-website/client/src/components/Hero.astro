---
const { images, title: heroTitle, subtitle } = Astro.props
const slides = images || [
  { url: '/images/hero-1.jpg', alt: 'Viaje' },
  { url: '/images/hero-2.jpg', alt: 'Viaje' },
  { url: '/images/hero-3.jpg', alt: 'Viaje' },
  { url: '/images/hero-4.jpg', alt: 'Viaje' },
]
---

<section class="hero">
  <div class="hero-slides">
    {slides.map(s => <img src={s.url} alt={s.alt} class="hero-slide" />)}
  </div>
  <div class="hero-overlay">
    <h1 class="hero-title">{heroTitle || 'Descubre el mundo'}</h1>
    <p class="hero-subtitle">{subtitle || 'Viajes únicos, experiencias inolvidables'}</p>
    <a href="/destinations" class="btn btn-gold hero-cta">Explorar destinos</a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100vh;
    min-height: 600px;
    overflow: hidden;
  }
  .hero-slides {
    position: absolute;
    inset: 0;
  }
  .hero-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    animation: fade 20s infinite;
  }
  .hero-slide:nth-child(1) { animation-delay: 0s; }
  .hero-slide:nth-child(2) { animation-delay: 5s; }
  .hero-slide:nth-child(3) { animation-delay: 10s; }
  .hero-slide:nth-child(4) { animation-delay: 15s; }
  @keyframes fade {
    0%, 20% { opacity: 1; }
    25%, 100% { opacity: 0; }
  }
  .hero-overlay {
    position: relative;
    z-index: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: rgba(0,0,0,0.35);
    color: white;
    text-align: center;
    padding: 0 20px;
  }
  .hero-title {
    font-size: clamp(2.5rem, 8vw, 5rem);
    font-weight: 900;
    margin-bottom: 16px;
    text-shadow: 0 2px 12px rgba(0,0,0,0.3);
  }
  .hero-subtitle {
    font-size: clamp(1rem, 2.5vw, 1.4rem);
    font-weight: 300;
    margin-bottom: 32px;
    opacity: 0.9;
  }
  .hero-cta {
    padding: 14px 40px;
    font-size: 1rem;
  }
</style>
