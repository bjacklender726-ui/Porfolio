---
const { apiEndpoint, columns, title: tableTitle } = Astro.props
---

<div class="admin-section">
  <div class="admin-header">
    <h3>{tableTitle}</h3>
    <button class="btn btn-primary" id="new-btn">+ Nuevo</button>
  </div>
  <table class="admin-table">
    <thead>
      <tr>{columns.map(c => <th>{c.label}</th>)}<th>Acciones</th></tr>
    </thead>
    <tbody id="table-body"></tbody>
  </table>
  <div id="table-msg" class="table-msg"></div>

  <div id="modal" class="modal" style="display:none">
    <div class="modal-content">
      <span class="modal-close" id="modal-close">&times;</span>
      <h3 id="modal-title">Nuevo</h3>
      <form id="modal-form" class="form"></form>
    </div>
  </div>
</div>

<style>
  .admin-section { background: white; padding: 24px; border-radius: 12px; box-shadow: var(--shadow); }
  .admin-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
  .admin-header h3 { font-family: 'Playfair Display', serif; }
  .admin-table { width: 100%; border-collapse: collapse; }
  .admin-table th, .admin-table td { padding: 10px 12px; text-align: left; border-bottom: 1px solid #eee; font-size: 0.9rem; }
  .admin-table th { font-weight: 600; color: var(--deep-blue); background: var(--sand); }
  .admin-table tr:hover { background: #f9f7f4; }
  .btn-sm { padding: 6px 14px; font-size: 0.8rem; cursor: pointer; border: none; border-radius: 4px; }
  .btn-edit { background: var(--gold); color: white; }
  .btn-delete { background: #dc3545; color: white; margin-left: 6px; }
  .table-msg { margin-top: 12px; padding: 10px; border-radius: var(--radius); display: none; }
  .table-msg.error { display: block; background: #f8d7da; color: #721c24; }
  .table-msg.loading { display: block; background: #fff3cd; color: #856404; }

  .modal { position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 200; display: flex; align-items: center; justify-content: center; }
  .modal-content { background: white; padding: 32px; border-radius: 12px; width: 90%; max-width: 500px; max-height: 80vh; overflow-y: auto; }
  .modal-close { float: right; font-size: 1.5rem; cursor: pointer; }
  .modal-content h3 { font-family: 'Playfair Display', serif; margin-bottom: 20px; }
  .modal-content .form { display: flex; flex-direction: column; gap: 12px; }
  .modal-content .form-group { display: flex; flex-direction: column; gap: 4px; }
  .modal-content .form-group label { font-size: 0.85rem; font-weight: 500; }
  .modal-content .form-group input,
  .modal-content .form-group textarea,
  .modal-content .form-group select {
    padding: 8px 12px; border: 1px solid #ddd; border-radius: var(--radius); font-size: 0.9rem;
  }
  .modal-content .form-group input:focus,
  .modal-content .form-group textarea:focus,
  .modal-content .form-group select:focus {
    outline: none; border-color: var(--gold); box-shadow: 0 0 0 3px rgba(212,168,83,0.15);
  }
</style>

<script>
  const endpoint = '{apiEndpoint}'
  const cols = JSON.parse('{JSON.stringify(columns)}')
  const token = localStorage.getItem('token')

  async function loadData() {
    const tbody = document.getElementById('table-body')
    const msg = document.getElementById('table-msg')
    msg.className = 'table-msg loading'
    msg.textContent = 'Cargando...'
    try {
      const res = await fetch(endpoint)
      const data = await res.json()
      if (!Array.isArray(data)) throw new Error('Respuesta inválida')
      tbody.innerHTML = data.map(row => {
        const fields = cols.map(c => {
          let val = row[c.key]
          if (c.type === 'image' && val) return `<img src="${val}" style="width:60px;height:40px;object-fit:cover;border-radius:4px" />`
          if (c.type === 'number' && val) return Number(val).toLocaleString('en-US')
          if (c.type === 'date' && val) return new Date(val).toLocaleDateString()
          return val || '-'
        }).join('</td><td>')
        return `<tr><td>${fields}</td><td>
          <button class="btn-sm btn-edit" data-id="${row.id}">Editar</button>
          <button class="btn-sm btn-delete" data-id="${row.id}">Eliminar</button>
        </td></tr>`
      }).join('')
      msg.style.display = 'none'
      attachEvents(data)
    } catch (e) {
      msg.className = 'table-msg error'
      msg.textContent = 'Error al cargar datos: ' + e.message
    }
  }

  function attachEvents(data) {
    document.querySelectorAll('.btn-edit').forEach(btn => {
      btn.onclick = () => {
        const item = data.find(d => d.id == btn.dataset.id)
        openModal('Editar', item)
      }
    })
    document.querySelectorAll('.btn-delete').forEach(btn => {
      btn.onclick = async () => {
        if (!confirm('¿Eliminar este registro?')) return
        const res = await fetch(`${endpoint}/${btn.dataset.id}`, { method: 'DELETE', headers: token ? { 'Authorization': `Bearer ${token}` } : {} })
        if (res.ok) loadData()
        else alert('Error al eliminar')
      }
    })
  }

  function openModal(title, item) {
    const modal = document.getElementById('modal')
    document.getElementById('modal-title').textContent = title
    const form = document.getElementById('modal-form')
    form.innerHTML = cols.filter(c => c.key !== 'id' && c.key !== 'created_at').map(c => {
      const val = item ? (item[c.key] || '') : ''
      if (c.key === 'destination_id' || c.key === 'package_id') {
        return `<div class="form-group"><label>${c.label}</label><input name="${c.key}" value="${val}" required /></div>`
      }
      if (c.key === 'description' || c.key === 'notes') {
        return `<div class="form-group"><label>${c.label}</label><textarea name="${c.key}" rows="3">${val}</textarea></div>`
      }
      if (c.key === 'price') {
        return `<div class="form-group"><label>${c.label}</label><input name="${c.key}" type="number" step="0.01" value="${val}" required /></div>`
      }
      return `<div class="form-group"><label>${c.label}</label><input name="${c.key}" value="${val}" required /></div>`
    }).join('')
    form.innerHTML += `<button type="submit" class="btn btn-primary">${title === 'Editar' ? 'Guardar cambios' : 'Crear'}</button>`
    form.onsubmit = async (e) => {
      e.preventDefault()
      const data = Object.fromEntries(new FormData(form))
      if (data.price) data.price = parseFloat(data.price)
      if (data.duration_days) data.duration_days = parseInt(data.duration_days)
      if (data.max_people) data.max_people = parseInt(data.max_people)
      if (data.people) data.people = parseInt(data.people)
      if (data.destination_id) data.destination_id = parseInt(data.destination_id)
      if (data.package_id) data.package_id = parseInt(data.package_id)
      const method = item ? 'PUT' : 'POST'
      const url = item ? `${endpoint}/${item.id}` : endpoint
      const res = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json', ...(token ? { 'Authorization': `Bearer ${token}` } : {}) },
        body: JSON.stringify(data),
      })
      if (res.ok) { modal.style.display = 'none'; loadData() }
      else { const err = await res.json(); alert(err.error || 'Error') }
    }
    modal.style.display = 'flex'
  }

  document.getElementById('new-btn').onclick = () => openModal('Nuevo', null)
  document.getElementById('modal-close').onclick = () => document.getElementById('modal').style.display = 'none'
  window.onclick = (e) => { if (e.target == document.getElementById('modal')) document.getElementById('modal').style.display = 'none' }

  loadData()
</script>
