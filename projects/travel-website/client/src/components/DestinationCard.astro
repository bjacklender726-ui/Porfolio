---
const { dest } = Astro.props
---

<a href={`/destinations/${dest.id}`} class="card dest-card">
  <div class="dest-img-wrap">
    <img src={dest.image_url || '/images/placeholder.jpg'} alt={dest.name} class="dest-img" loading="lazy" />
  </div>
  <div class="dest-body">
    <span class="dest-country">{dest.country}</span>
    <h3 class="dest-name">{dest.name}</h3>
    <p class="dest-desc">{dest.description?.slice(0, 100)}...</p>
  </div>
</a>

<style>
  .dest-card { display: block; }
  .dest-img-wrap {
    height: 220px;
    overflow: hidden;
  }
  .dest-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition);
  }
  .dest-card:hover .dest-img { transform: scale(1.05); }
  .dest-body { padding: 20px; }
  .dest-country {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--terracotta);
    font-weight: 600;
  }
  .dest-name {
    font-family: 'Playfair Display', serif;
    font-size: 1.3rem;
    margin: 6px 0 10px;
  }
  .dest-desc {
    font-size: 0.9rem;
    color: var(--text-light);
    line-height: 1.5;
  }
</style>
