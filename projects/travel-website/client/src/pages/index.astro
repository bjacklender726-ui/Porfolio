---
import Base from '../layouts/Base.astro'
import Hero from '../components/Hero.astro'
---

<Base title="Inicio">
  <Hero
    images={[
      { url: '/images/hero-1.jpg', alt: 'Destino' },
      { url: '/images/hero-2.jpg', alt: 'Destino' },
      { url: '/images/hero-3.jpg', alt: 'Destino' },
      { url: '/images/hero-4.jpg', alt: 'Destino' },
    ]}
    title="Descubre el mundo"
    subtitle="Viajes únicos, experiencias inolvidables"
  />

  <section class="section">
    <div class="container">
      <h2 class="section-title">Destinos destacados</h2>
      <p class="section-desc">Explora nuestros destinos más populares y encuentra tu próxima aventura.</p>
      <div class="dest-grid" id="dest-grid"></div>
      <div class="section-cta">
        <a href="/destinations" class="btn btn-secondary">Ver todos los destinos</a>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2 class="section-title">¿Por qué Viajeros?</h2>
      <div class="features-grid">
        <div class="feature-card">
          <span class="feature-icon">🌍</span>
          <h3>Destinos únicos</h3>
          <p>Seleccionamos los mejores lugares para que vivas experiencias auténticas.</p>
        </div>
        <div class="feature-card">
          <span class="feature-icon">🤝</span>
          <h3>Acompañamiento</h3>
          <p>Guías locales expertos te acompañan en cada destino.</p>
        </div>
        <div class="feature-card">
          <span class="feature-icon">💰</span>
          <h3>Mejor precio</h3>
          <p>Paquetes todo incluido con la mejor relación calidad-precio.</p>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .section-title { text-align: center; font-size: 2rem; margin-bottom: 12px; color: var(--deep-blue); }
  .section-desc { text-align: center; color: var(--text-light); margin-bottom: 40px; font-size: 1.05rem; }
  .dest-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(270px, 1fr)); gap: 24px; }
  .section-cta { text-align: center; margin-top: 40px; }
  .section-alt { background: var(--sand); }
  .features-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 32px; }
  .feature-card { text-align: center; padding: 32px; background: white; border-radius: 12px; box-shadow: var(--shadow); }
  .feature-icon { font-size: 2.5rem; display: block; margin-bottom: 16px; }
  .feature-card h3 { font-family: 'Playfair Display', serif; font-size: 1.2rem; margin-bottom: 10px; color: var(--deep-blue); }
  .feature-card p { font-size: 0.9rem; color: var(--text-light); }
</style>

<script>
  fetch('/api/destinations').then(r => r.json()).then(dests => {
    const grid = document.getElementById('dest-grid')
    grid.innerHTML = dests.slice(0, 4).map(d => `
      <a href="/destinations/${d.id}" class="card dest-card" style="display:block">
        <div style="height:220px;overflow:hidden">
          <img src="${d.image_url || '/images/placeholder.jpg'}" alt="${d.name}" style="width:100%;height:100%;object-fit:cover;transition:transform 0.3s" loading="lazy" />
        </div>
        <div style="padding:20px">
          <span style="font-size:0.8rem;text-transform:uppercase;letter-spacing:1px;color:var(--terracotta);font-weight:600">${d.country}</span>
          <h3 style="font-family:'Playfair Display',serif;font-size:1.3rem;margin:6px 0 10px">${d.name}</h3>
          <p style="font-size:0.9rem;color:var(--text-light);line-height:1.5">${(d.description || '').slice(0, 100)}...</p>
        </div>
      </a>
    `).join('')
  }).catch(() => {})
</script>
