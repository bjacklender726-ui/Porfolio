---
import Base from '../layouts/Base.astro'
---

<Base title="Iniciar sesión">
  <section class="section auth-page">
    <div class="container">
      <div class="auth-card">
        <h1>Iniciar sesión</h1>
        <form id="login-form" class="form">
          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" required />
          </div>
          <div class="form-group">
            <label for="password">Contraseña</label>
            <input type="password" id="password" name="password" required />
          </div>
          <button type="submit" class="btn btn-primary" style="width:100%">Ingresar</button>
        </form>
        <div id="login-msg" class="auth-msg"></div>
        <p class="auth-link">¿No tienes cuenta? <a href="/register">Regístrate</a></p>
      </div>
    </div>
  </section>
</Base>

<style>
  .auth-page { padding-top: 140px; min-height: 100vh; display: flex; align-items: flex-start; justify-content: center; }
  .auth-card {
    background: white; padding: 40px; border-radius: 12px; box-shadow: var(--shadow);
    width: 100%; max-width: 420px;
  }
  .auth-card h1 { font-family: 'Playfair Display', serif; text-align: center; margin-bottom: 24px; color: var(--deep-blue); }
  .form { display: flex; flex-direction: column; gap: 16px; }
  .form-group { display: flex; flex-direction: column; gap: 6px; }
  .form-group label { font-size: 0.85rem; font-weight: 500; }
  .form-group input {
    padding: 10px 14px; border: 1px solid #ddd; border-radius: var(--radius); font-size: 0.95rem;
  }
  .form-group input:focus { outline: none; border-color: var(--gold); box-shadow: 0 0 0 3px rgba(212,168,83,0.15); }
  .auth-msg { margin-top: 12px; padding: 10px; border-radius: var(--radius); display: none; text-align: center; }
  .auth-msg.error { display: block; background: #f8d7da; color: #721c24; }
  .auth-link { text-align: center; margin-top: 16px; font-size: 0.9rem; }
  .auth-link a { color: var(--terracotta); font-weight: 500; }
</style>

<script>
  document.getElementById('login-form')?.addEventListener('submit', async (e) => {
    e.preventDefault()
    const data = Object.fromEntries(new FormData(e.target))
    const msg = document.getElementById('login-msg')
    try {
      const res = await fetch('/api/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      })
      if (res.ok) {
        const json = await res.json()
        localStorage.setItem('token', json.token)
        localStorage.setItem('user', JSON.stringify(json.user))
        window.location.href = '/mis-reservas'
      } else {
        const err = await res.json()
        msg.className = 'auth-msg error'
        msg.textContent = err.error || 'Error al iniciar sesión'
      }
    } catch {
      msg.className = 'auth-msg error'
      msg.textContent = 'Error de conexión'
    }
  })
</script>
