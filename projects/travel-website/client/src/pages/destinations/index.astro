---
import Base from '../../layouts/Base.astro'
---

<Base title="Destinos">
  <section class="section page-hero">
    <div class="container">
      <h1 class="page-title">Destinos</h1>
      <p class="page-desc">Explora todos nuestros destinos y encuentra tu próxima aventura.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="dest-grid" id="dest-grid"></div>
      <p class="empty" id="dest-empty" style="display:none">No hay destinos disponibles aún.</p>
    </div>
  </section>
</Base>

<style>
  .page-hero { padding-top: 140px; padding-bottom: 40px; background: var(--deep-blue); color: white; }
  .page-title { font-size: 2.5rem; margin-bottom: 8px; }
  .page-desc { opacity: 0.85; font-size: 1.05rem; }
  .dest-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(270px, 1fr)); gap: 24px; }
  .empty { text-align: center; color: var(--text-light); padding: 60px; }
</style>

<script>
  fetch('/api/destinations').then(r => r.json()).then(dests => {
    const grid = document.getElementById('dest-grid')
    const empty = document.getElementById('dest-empty')
    if (!dests.length) { empty.style.display = 'block'; return }
    grid.innerHTML = dests.map(d => `
      <a href="/destinations/${d.id}" class="card dest-card" style="display:block">
        <div style="height:220px;overflow:hidden;background:var(--sand);display:flex;align-items:center;justify-content:center">
          ${d.image_url
            ? `<img src="${d.image_url}" alt="${d.name}" style="width:100%;height:100%;object-fit:cover;transition:transform 0.3s" loading="lazy" />`
            : `<div style="padding:20px;text-align:center;color:var(--text-light)"><svg width="48" height="48" viewBox="0 0 80 80" fill="none" style="margin:0 auto 8px;display:block;opacity:0.3"><circle cx="40" cy="40" r="36" stroke="#7A706C" stroke-width="2" fill="none"/><ellipse cx="40" cy="40" rx="18" ry="28" stroke="#7A706C" stroke-width="1.5" fill="none"/><ellipse cx="40" cy="40" rx="30" ry="12" stroke="#7A706C" stroke-width="1.5" fill="none"/><line x1="14" y1="40" x2="66" y2="40" stroke="#7A706C" stroke-width="1.5"/></svg><span style="font-size:0.8rem;display:block">Sin imagen</span></div>`
          }
        </div>
        <div style="padding:20px">
          <span style="font-size:0.8rem;text-transform:uppercase;letter-spacing:1px;color:var(--terracotta);font-weight:600">${d.country}</span>
          <h3 style="font-family:'Playfair Display',serif;font-size:1.3rem;margin:6px 0 10px">${d.name}</h3>
          <p style="font-size:0.9rem;color:var(--text-light);line-height:1.5">${(d.description || '').slice(0, 100)}...</p>
        </div>
      </a>
    `).join('')
  }).catch(() => {})
</script>
