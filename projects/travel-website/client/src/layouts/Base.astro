---
import '../styles/global.css'
import Footer from '../components/Footer.astro'
const { title } = Astro.props
const path = Astro.url.pathname
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title ? `${title} | Viajeros` : 'Viajeros'}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>
  <nav id="navbar" class="navbar">
    <div class="container nav-inner">
      <a href="/" class="logo">Viajeros</a>
      <div class="nav-links" id="nav-links">
        <a href="/destinations" class={path.startsWith('/destinations') ? 'active' : ''}>Destinos</a>
        <a href="/packages" class={path.startsWith('/packages') ? 'active' : ''}>Paquetes</a>
      </div>
    </div>
  </nav>

  <main>
    <slot />
  </main>

  <Footer />
</body>
</html>

<script>
  window.addEventListener('scroll', () => {
    const nav = document.getElementById('navbar')
    nav.classList.toggle('scrolled', window.scrollY > 80)
  })

  const token = localStorage.getItem('token')
  const user = JSON.parse(localStorage.getItem('user') || 'null')
  const nav = document.getElementById('nav-links')
  if (token && user) {
    const resLink = document.createElement('a')
    resLink.href = '/mis-reservas'
    resLink.textContent = 'Mis reservas'
    if (window.location.pathname === '/mis-reservas') resLink.className = 'active'
    nav.appendChild(resLink)
    const logoutLink = document.createElement('a')
    logoutLink.href = '#'
    logoutLink.textContent = 'Cerrar sesión'
    logoutLink.style.opacity = '0.7'
    logoutLink.addEventListener('click', (e) => {
      e.preventDefault()
      localStorage.removeItem('token')
      localStorage.removeItem('user')
      window.location.href = '/'
    })
    nav.appendChild(logoutLink)
  } else {
    const loginLink = document.createElement('a')
    loginLink.href = '/login'
    loginLink.textContent = 'Iniciar sesión'
    if (window.location.pathname === '/login' || window.location.pathname === '/register') loginLink.className = 'active'
    nav.appendChild(loginLink)
  }
</script>